# URL base del gateway de la Videoteca (Spring Cloud Gateway).
# Aquest valor és només visible des del servidor Nuxt (no s'exposa al navegador).
# L'endpoint /api/movies d'aquest microservi crida a:  {NUXT_GATEWAY_URL}/api/movies
#
# Desenvolupament local (gateway via docker-compose al host:8090):
NUXT_GATEWAY_URL=http://localhost:8090
#
# Si el frontend corre dins de Docker, el compose ja la configura amb
# http://gateway:8080 (nom del servei + port intern del contenedor).
